{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "islemap-thienvyma",
  "version": "2.2.0",
  "identifier": "vn.huynhvy.islemap-thienvyma",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "islemap-thienvyma",
        "url": "index.html",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$LOCALDATA/islemap-thienvyma-data/**"]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["islemap-thienvyma", "theisle-overlay"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY2NENFMkM3REVBQTY0RDAKUldUUVpLcmV4K0pNOWtaQjRueUxFOHN2OUc3SlAwN3U5QURWai9Tbk1xVUxETDNNQUFKS0FYbXQK",
      "endpoints": [
        "https://github.com/thienvyma/hubisle/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/islemap-thienvyma-telemetry"],
    "resources": {
      "../sidecars/local-telemetry/THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.local-telemetry.md"
    },
    "publisher": "Huỳnh Vỹ",
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/installer-hooks.nsh",
        "languages": ["Vietnamese", "English"]
      }
    }
  }
}
