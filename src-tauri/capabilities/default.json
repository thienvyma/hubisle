{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main and minimap windows",
  "windows": ["main", "minimap", "minimap-*"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "dialog:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://www.facebook.com/thienvyma*" },
        { "url": "https://github.com/thienvyma/hubisle*" }
      ]
    },
    "log:default",
    "updater:allow-check",
    "updater:allow-download-and-install"
  ]
}
