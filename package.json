{
  "name": "islemap-thienvyma",
  "private": true,
  "version": "2.6.0",
  "author": "thienvyma",
  "homepage": "https://github.com/thienvyma/hubisle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thienvyma/hubisle.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "vite build --configLoader runner",
    "build:sidecar": "powershell -ExecutionPolicy Bypass -File scripts/build-local-telemetry-sidecar.ps1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:updater": "node scripts/check-updater.mjs",
    "test:updater": "node --experimental-strip-types --test scripts/update*.test.mjs",
    "test:heading": "node --experimental-strip-types --test scripts/heading.test.mjs tools/compass-lab/solver.test.mjs",
    "test:minimap-friends": "node --experimental-strip-types --test scripts/minimap-friends.test.mjs",
    "test:garage": "node --experimental-strip-types --test scripts/garage-park.test.mjs",
    "test:installer": "node --test scripts/installer-safety.test.mjs",
    "test:release-trust": "node --test scripts/release-trust.test.mjs",
    "test:provider-defaults": "node --experimental-strip-types --test scripts/provider-defaults.test.mjs",
    "test:skin": "node --experimental-strip-types --test scripts/skin-*.test.mjs",
    "test:voice": "node --test scripts/voice-provider.test.mjs",
    "test:mutations": "node --experimental-strip-types --test scripts/mutations.test.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-log": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "leaflet": "^1.9",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@types/leaflet": "^1.9",
    "@types/three": "^0.185.4",
    "svelte": "^5",
    "svelte-check": "^4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7"
  },
  "license": "GPL-3.0-only"
}
